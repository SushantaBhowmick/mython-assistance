generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  email        String?
  name         String?
  age          Int?
  dateOfBirth  DateTime? @map("date_of_birth")
  phone        String?
  location     String?
  avatarUrl    String?   @map("avatar_url")
  about        String?   @db.Text
  githubUrl    String?   @map("github_url")
  linkedinUrl  String?   @map("linkedin_url")
  skills       String[]  @default([])
  career       Json?
  experience   Json?
  education    Json?
  projects     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReminderStatus {
  PENDING
  DONE
  SNOOZED
}

model Note {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  title     String
  body      String     @default("") @db.Text
  tags      String[]   @default([])
  pinned    Boolean    @default(false)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  reminders Reminder[]

  @@index([userId, updatedAt])
  @@index([userId, pinned])
  @@map("notes")
}

model Task {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?    @map("due_at")
  completedAt  DateTime?    @map("completed_at")
  projectTag   String?      @map("project_tag")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  reminders    Reminder[]

  @@index([userId, status])
  @@index([userId, dueAt])
  @@map("tasks")
}

model Reminder {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  title        String
  remindAt     DateTime       @map("remind_at")
  status       ReminderStatus @default(PENDING)
  snoozedUntil DateTime?      @map("snoozed_until")
  taskId       String?        @map("task_id")
  noteId       String?        @map("note_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  note Note? @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([userId, remindAt])
  @@index([userId, status])
  @@map("reminders")
}

model YouTubeCache {
  id             String   @id @default(cuid())
  query          String   @unique
  results        Json
  expiresAt      DateTime @map("expires_at")
  lastAccessedAt DateTime @default(now()) @map("last_accessed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([lastAccessedAt])
  @@map("youtube_cache")
}

model SavedTrack {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  videoId      String   @map("video_id")
  title        String
  channelTitle String   @map("channel_title")
  thumbnailUrl String   @map("thumbnail_url")
  duration     String?
  source       String   @default("youtube")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  favorites        Favorite[]
  playlistTracks   PlaylistTrack[]
  listeningHistory ListeningHistory[]
  trackStats       TrackStats[]

  @@unique([userId, videoId])
  @@index([userId])
  @@map("saved_tracks")
}

model Playlist {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  coverImage  String?  @map("cover_image")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tracks PlaylistTrack[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String   @map("playlist_id")
  trackId    String   @map("track_id")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  playlist Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    SavedTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@map("playlist_tracks")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  trackId   String   @map("track_id")
  createdAt DateTime @default(now()) @map("created_at")

  track SavedTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@map("favorites")
}

model ListeningHistory {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  trackId  String   @map("track_id")
  playedAt DateTime @default(now()) @map("played_at")

  track SavedTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, playedAt])
  @@map("listening_history")
}

model TrackStats {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  trackId        String   @map("track_id")
  playCount      Int      @default(0) @map("play_count")
  firstPlayedAt  DateTime @default(now()) @map("first_played_at")
  lastPlayedAt   DateTime @default(now()) @map("last_played_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  track SavedTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, lastPlayedAt])
  @@index([userId, playCount])
  @@map("track_stats")
}

model NotificationToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  token      String    @unique
  platform   String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@index([userId])
  @@map("notification_tokens")
}
