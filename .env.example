# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
# Use pooler (6543) for app runtime; direct/session pooler (5432) for migrations.
# If password contains @ # % etc., URL-encode it (e.g. Mython@3214 → Mython%403214).
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (required for Phase 2+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time owner seed: npm run seed:owner
SEED_OWNER_PASSWORD=mython@321

# Local only — skip Supabase (not for production)
# AUTH_DEV_BYPASS=true

# YouTube Data API v3 (server-only — never expose to client)
YOUTUBE_API_KEY=

# Firebase (MVP 4+ — not required for music MVP)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Phase 3 — Reminder push when app is closed (Hobby: use external cron, not vercel.json)
# Set a long random string. External cron calls GET /api/cron/reminders with either:
#   Authorization: Bearer <CRON_SECRET>
#   or header: X-Cron-Secret: <CRON_SECRET>
# Do NOT use cron-job.org "HTTP authentication" (Basic). Use a custom header instead.
# Free option: https://cron-job.org every 5–15 min (Vercel Hobby allows only 1×/day in vercel.json).
CRON_SECRET=
OWNER_USER_ID=

# Phase 3G — Gemini today brief (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Phase 3H — Automation webhooks (optional)
AUTOMATION_SECRET=

# Tasks → Google Calendar (optional — Settings → Integrations)
# Enable Calendar API + OAuth Web client in Google Cloud Console.
# Redirect URI must match exactly (local example below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
